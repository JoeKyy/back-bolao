{
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".*\\.e2e-spec\\.ts$",
  "transform": { "^.+\\.ts$": ["ts-jest", { "tsconfig": "<rootDir>/../tsconfig.json" }] },
  "moduleFileExtensions": ["ts", "js", "json"],
  "setupFiles": ["<rootDir>/env.ts"],
  "globalSetup": "<rootDir>/global-setup.ts",
  "testTimeout": 30000
}
