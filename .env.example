# Banco (docker compose sobe o Postgres local na porta 5433)
POSTGRES_PASSWORD=troque-esta-senha
DATABASE_URL=postgresql://bolao:troque-esta-senha@localhost:5433/bolao?schema=public

# Origem do front, para CORS e conferência de Origin (separe várias por vírgula)
CORS_ORIGINS=http://localhost:3000

# Organizador criado no primeiro boot, se ainda não houver nenhum.
# Senha com 12+ caracteres. Depois de criado, mudar aqui NÃO troca a senha.
ADMIN_EMAIL=organizador@exemplo.com
ADMIN_PASSWORD=troque-por-uma-senha-longa

# Proxy reverso confiável. Local: deixe vazio (usa o IP da conexão).
# Atrás do nginx do CloudPanel na mesma máquina: loopback
TRUST_PROXY=

# Ligue a consulta à API pública da Caixa (resultado e estimativa).
CAIXA_API_URL=https://servicebus2.caixa.gov.br/portaldeloterias/api/megasena

PORT=3333

# "Esqueci minha senha" por e-mail (opcional). Sem SMTP_URL, o pedido responde igual mas não envia;
# o organizador usa um código de recuperação ou pede um link novo ao administrador.
# Ex.: smtps://<usuario>:<senha>@<servidor-smtp>:465
SMTP_URL=
MAIL_FROM=Bolão da Mega <nao-responda@joekyy.com.br>
# Nome anunciado no EHLO quando o relay é o Postfix local (FQDN que resolva para a VPS). No servidor:
#   SMTP_URL=smtp://127.0.0.1:25  e  MAIL_HELO=bolao.joekyy.com.br
MAIL_HELO=
# Endereço público do front, usado nos links dos e-mails
APP_URL=http://localhost:3000
