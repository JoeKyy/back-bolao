# /srv/bolao/homolog/back/.env   (dono: deploy, modo 600). NUNCA vai para o git.
COMPOSE_PROJECT_NAME=bolao-homolog-back
API_PORT=3433
INITDB_DIR=./initdb
POSTGRES_PORT=5533

POSTGRES_USER=bolao
POSTGRES_DB=bolao
# Gere cada senha com: openssl rand -base64 33 | tr -d '/+=' | cut -c1-40
POSTGRES_PASSWORD=
# Papel só de dados que a API usa (BAUD-07). Só vale se definido ANTES da primeira subida do Postgres.
BOLAO_APP_PASSWORD=

CORS_ORIGINS=https://homolog-bolao.joekyy.com.br
APP_URL=https://homolog-bolao.joekyy.com.br

# Organizador inicial (admin e tesoureiro). Só é lido no primeiro boot; depois APAGUE a senha daqui.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# E-mail do "esqueci minha senha" (opcional). Ex.: smtps://<usuario>:<senha>@<servidor-smtp>:465
# E-mail ("esqueci minha senha"). No mesmo modelo do gestor de conteudo da Nahub: o Postfix do
# proprio host e o relay, sem credencial (a API usa network_mode host, entao 127.0.0.1:25 chega nele).
# MAIL_HELO e o nome que a API anuncia no EHLO (precisa ser um FQDN que resolva para esta VPS).
# Fora daqui, qualquer SMTP com credencial serve: smtps://<usuario>:<senha>@<servidor-smtp>:465
# Para entregar bem (Gmail), o dominio do remetente precisa de SPF com o IP da VPS e de DKIM.
SMTP_URL=smtp://127.0.0.1:25
MAIL_HELO=homolog-bolao.joekyy.com.br
MAIL_FROM=Bolão da Mega <nao-responda@joekyy.com.br>
