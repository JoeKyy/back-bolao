// Bolão da Mega. Dinheiro sempre em centavos (Int cobre até R$ 21 milhões por campo;
// prêmios usam BigInt porque a Virada passa de R$ 1 bilhão).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Conta de acesso. Perfis combináveis (como os perfis do gestor, mas independentes):
/// - admin: gerencia contas e perfis; NÃO enxerga os bolões dos outros.
/// - tesoureiro: cria e administra os próprios bolões (Pix, convites, pagamentos, registro).
/// Sem nenhum dos dois é pessoa comum: só participa de bolões. O primeiro usuário, criado no
/// boot a partir do .env, nasce admin e tesoureiro.
model Usuario {
  id         Int                   @id @default(autoincrement())
  email      String                @unique
  nome       String                @default("")
  admin      Boolean               @default(false)
  tesoureiro Boolean               @default(false)
  ativo     Boolean               @default(true)
  /// Nulo = conta criada pelo ADMIN com convite ainda não aceito (como no gestor).
  senhaHash String?
  criadoEm  DateTime              @default(now())
  sessoes   Sessao[]
  aparelhos AparelhoOrganizador[]
  boloes    Bolao[]
  convites  ConviteOrganizador[]
  codigos   CodigoRecuperacao[]
  participacoes Participante[]
  atividade EventoConta[]
}

/// Trilha das ações sobre a conta (BAUD-02): link de acesso emitido, senha definida por link,
/// perfis, ativação. A própria pessoa vê em "Minha conta". Sem isto o administrador podia gerar
/// um link, trocar a senha de alguém e entrar como a pessoa sem deixar rastro.
model EventoConta {
  id        Int      @id @default(autoincrement())
  usuarioId Int
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  /// Quem fez (administrador), quando foi outra pessoa; nulo quando a própria pessoa.
  porId     Int?
  tipo      String
  descricao String
  criadoEm  DateTime @default(now())

  @@index([usuarioId, criadoEm])
}

/// Link de uso único para definir a senha: ativa a conta nova (convite) ou troca a senha de uma
/// conta existente (reemissão pelo ADMIN ou "esqueci minha senha"). Mesmo esquema do gestor
/// (InviteToken). No banco só o sha256 do token.
model ConviteOrganizador {
  id        Int       @id @default(autoincrement())
  tokenHash String    @unique
  usuarioId Int
  usuario   Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  criadoEm  DateTime  @default(now())
  expiraEm  DateTime
  usadoEm   DateTime?

  @@index([usuarioId])
}

/// Códigos de recuperação (8 por lote, uso único), gerados pelo próprio organizador com a senha
/// atual. Como no gestor (RecoveryCode). No banco só o sha256.
model CodigoRecuperacao {
  id         Int       @id @default(autoincrement())
  usuarioId  Int
  usuario    Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  codigoHash String    @unique
  usadoEm    DateTime?
  criadoEm   DateTime  @default(now())

  @@index([usuarioId])
}

/// Aparelho onde o organizador já entrou com sucesso (cookie aleatório; aqui só o sha256).
/// Com o limite global de falhas estourado por terceiros, ele ainda entra por aqui (SEC-06).
model AparelhoOrganizador {
  id        Int      @id @default(autoincrement())
  tokenHash String   @unique
  usuarioId Int
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  criadoEm  DateTime @default(now())

  @@index([usuarioId])
}

/// Sessão do organizador. O cookie leva um token aleatório; aqui fica só o sha256 dele (BOL-02).
model Sessao {
  id          Int      @id @default(autoincrement())
  tokenHash   String   @unique
  usuarioId   Int
  usuario     Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  criadoEm    DateTime @default(now())
  expiraEm    DateTime
  ultimoUsoEm DateTime @default(now())

  @@index([usuarioId])
}

/// Contagem de tentativas para limites (login, inscrição). Persistente: reiniciar não zera (BOL-01).
model Tentativa {
  id       Int      @id @default(autoincrement())
  chave    String
  criadoEm DateTime @default(now())

  @@index([chave, criadoEm])
}

enum TipoBolao {
  VIRADA
  NORMAL
}

enum FonteResultado {
  caixa
  manual
}

model Bolao {
  id                     Int             @id @default(autoincrement())
  /// O tesoureiro: único que configura Pix, convida, confirma pagamento, exporta e registra.
  donoId                 Int
  dono                   Usuario         @relation(fields: [donoId], references: [id], onDelete: Restrict)
  nome                   String
  tipo                   TipoBolao       @default(NORMAL)
  /// Token do link de convite. Gerar outro invalida o link antigo.
  convite                String          @unique
  concurso               Int?
  dataSorteio            DateTime?
  /// Preço da aposta simples (6 dezenas), em centavos. Editável caso a Caixa reajuste.
  precoSimples           Int             @default(600)
  maxDezenasParticipante Int             @default(10)
  maxParticipantes       Int             @default(200)
  inscricoesAbertas      Boolean         @default(true)
  instrucoes             String          @default("")
  pixChave               String?
  pixNome                String?
  pixCidade              String?
  /// Prêmio estimado (centavos) usado na calculadora.
  estimativaPremio       BigInt?
  resultadoDezenas       Int[]
  premioSena             BigInt?
  premioQuina            BigInt?
  premioQuadra           BigInt?
  resultadoFonte         FonteResultado?
  resultadoEm            DateTime?
  criadoEm               DateTime        @default(now())
  participantes          Participante[]
  jogos                  Jogo[]
  eventos                Evento[]

  @@index([donoId])
}

model Participante {
  id           Int                @id @default(autoincrement())
  bolaoId      Int
  bolao        Bolao              @relation(fields: [bolaoId], references: [id], onDelete: Cascade)
  /// Conta da pessoa, quando ela participa logada (vê o bolão em qualquer aparelho).
  usuarioId    Int?
  usuario      Usuario?           @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  nome         String
  whatsapp     String             @default("")
  /// Quanto o organizador confirmou ter recebido (centavos).
  valorPago    Int                @default(0)
  pagoEm       DateTime?
  criadoEm     DateTime           @default(now())
  jogos        Jogo[]
  dispositivos DispositivoAcesso[]

  @@unique([bolaoId, usuarioId])
  @@index([bolaoId])
  @@index([usuarioId])
}

/// Liga o aparelho do participante (cookie aleatório; aqui só o sha256) ao cadastro dele.
model DispositivoAcesso {
  id             Int          @id @default(autoincrement())
  tokenHash      String
  participanteId Int
  participante   Participante @relation(fields: [participanteId], references: [id], onDelete: Cascade)
  criadoEm       DateTime     @default(now())

  @@unique([tokenHash, participanteId])
  @@index([tokenHash])
}

model Jogo {
  id             Int          @id @default(autoincrement())
  bolaoId        Int
  bolao          Bolao        @relation(fields: [bolaoId], references: [id], onDelete: Cascade)
  participanteId Int
  participante   Participante @relation(fields: [participanteId], references: [id], onDelete: Cascade)
  dezenas        Int[]
  surpresinha    Boolean      @default(false)
  /// Marcado pelo organizador depois de registrar o jogo na Caixa. Só jogo registrado é conferido.
  registrado     Boolean      @default(false)
  comprovante    String?
  criadoEm       DateTime     @default(now())

  @@index([bolaoId])
  @@index([participanteId])
}

/// Histórico do que mexe com dinheiro e resultado (BOL-04).
model Evento {
  id        Int      @id @default(autoincrement())
  bolaoId   Int
  bolao     Bolao    @relation(fields: [bolaoId], references: [id], onDelete: Cascade)
  tipo      String
  descricao String
  dados     Json?
  criadoEm  DateTime @default(now())

  @@index([bolaoId, criadoEm])
}
